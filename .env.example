# Modern Accounting System - Environment Configuration
# Copy this file to .env and update with your actual values

# ========================================
# Application Settings
# ========================================
API_V1_STR=/api/v1
PROJECT_NAME=Modern Accounting System
VERSION=1.0.0
DEBUG=True
RELOAD=True
HOST=0.0.0.0
PORT=8000

# ========================================
# Database Configuration
# ========================================
# For PoC (SQLite)
DATABASE_URL=sqlite+aiosqlite:///./accounting.db
ECHO_SQL=True

# For Production (PostgreSQL) - uncomment and configure
# POSTGRES_SERVER=localhost
# POSTGRES_USER=accounting_user
# POSTGRES_PASSWORD=your_secure_password
# POSTGRES_DB=accounting_db
# POSTGRES_PORT=5432
# DATABASE_URL=postgresql+asyncpg://accounting_user:your_secure_password@localhost:5432/accounting_db

# ========================================
# Security
# ========================================
# Generate a secure key: openssl rand -hex 32
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# ========================================
# CORS Origins (comma-separated)
# ========================================
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# ========================================
# AI Configuration
# ========================================
# Google Gemini (Primary AI Provider)
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-pro
GEMINI_VISION_MODEL=gemini-pro-vision
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_TOKENS=2048

# OpenAI (Optional Alternative)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_TEMPERATURE=0.7

# Anthropic (Optional Alternative)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-opus-20240229

# AI Features Toggle
AI_ENABLED=True
AI_AUTO_CATEGORIZE=True
AI_OCR_ENABLED=True
AI_PREDICTION_ENABLED=True
AI_CHAT_ENABLED=True

# AI Confidence Thresholds
AI_CATEGORIZATION_THRESHOLD=0.80
AI_OCR_CONFIDENCE_THRESHOLD=0.85
AI_PREDICTION_CONFIDENCE_THRESHOLD=0.75

# Tesseract OCR Path (optional, leave empty for default)
TESSERACT_CMD=

# ========================================
# Redis (for background tasks)
# ========================================
REDIS_URL=redis://localhost:6379/0

# ========================================
# File Upload
# ========================================
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760
# File extensions (comma-separated)
ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png,xlsx,xls,csv,doc,docx

# ========================================
# Email Configuration (optional)
# ========================================
SMTP_TLS=True
SMTP_PORT=587
SMTP_HOST=smtp.gmail.com
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAILS_FROM_EMAIL=noreply@yourcompany.com
EMAILS_FROM_NAME=Accounting System

# ========================================
# Application Defaults
# ========================================
DEFAULT_CURRENCY=USD
DEFAULT_LANGUAGE=en
DATE_FORMAT=%Y-%m-%d
DATETIME_FORMAT=%Y-%m-%d %H:%M:%S
FISCAL_YEAR_START_MONTH=1

# Pagination
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=1000

# Accounting Settings
DECIMAL_PLACES=4
REQUIRE_APPROVAL_ABOVE=10000.00
AUTO_POST_INVOICES=False
AUTO_POST_BILLS=False

# ========================================
# Logging
# ========================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ========================================
# Rate Limiting
# ========================================
RATE_LIMIT_PER_MINUTE=60
